{
  "name": "hiraganized-installer",
  "productName": "Hiraganized Installer",
  "version": "1.3.2",
  "description": "Installs Hiraganized – kanji context for Windows",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.hiraganized.installer",
    "productName": "Hiraganized Installer",
    "asar": true,
    "compression": "normal",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist/win-unpacked/resources/app.asar",
        "to": "bundled-app/app.asar"
      },
      {
        "from": "../dist/win-unpacked/Hiraganized.exe",
        "to": "bundled-app/Hiraganized.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "../assets/icon.png"
    },
    "portable": {
      "artifactName": "Hiraganized-Setup-${version}.${ext}",
      "requestExecutionLevel": "admin"
    }
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  }
}
